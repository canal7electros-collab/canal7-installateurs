{
  "name": "canal7",
  "productName": "Canal 7",
  "version": "1.0.0",
  "description": "Canal 7 — l'app des électros",
  "author": "Canal 7",
  "main": "main.js",
  "scripts": { "dist": "electron-builder --publish never" },
  "devDependencies": { "electron": "31.7.7", "electron-builder": "24.13.3" },
  "build": {
    "appId": "fr.canal7.app",
    "productName": "Canal 7",
    "directories": { "buildResources": "build" },
    "files": ["main.js", "package.json"],
    "mac": { "target": [{ "target": "dmg", "arch": ["universal"] }], "category": "public.app-category.productivity", "artifactName": "Canal7.dmg" },
    "win": { "target": ["nsis"], "artifactName": "Canal7-Setup.exe" },
    "nsis": { "oneClick": true, "perMachine": false, "createDesktopShortcut": true, "shortcutName": "Canal 7" }
  }
}
